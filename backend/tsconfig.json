{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@alphonsol/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "../packages/shared/src"],
  "exclude": ["node_modules", "dist"]
}
